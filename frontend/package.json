    "axios": "^1.8.4",
    "lodash": "^4.17.21",
    "pinia": "^3.0.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.3",
    "tailwindcss": "^4.0.17",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.6",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.13.9",
    "@vitejs/plugin-vue": "^5.2.1",
